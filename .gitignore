node_modules/
web/build/
web/.svelte-kit/
*.osm.pbf
*.log
.env
.DS_Store

# Screenshots the Claude desktop app drops into the repo folder
Claude outputs/

__pycache__/
*.pyc
*.tgz

# Map tiles are build artifacts, not source. Build them with
# scripts/build_basemap.py + scripts/build_admin_tiles.py, or fetch them
# with scripts/fetch_tiles.sh. See docs/TILES.md.
web/static/*.pmtiles
# ...except the two the live site needs. Cloudflare Pages builds from this
# repo, so a tile archive that is not committed here means a deployed site
# with a blank map. dhaka.pmtiles (50 MB, full detail) deliberately stays
# out: it is over the 25 MiB per-file limit Pages enforces. Build it locally
# per docs/TILES.md when you want zoom 15.
!web/static/dhaka-z14.pmtiles
!web/static/dhaka_admin.pmtiles

# Generated at build time from og-demo.png / og-beta.png
web/static/og.png

# Exploded tile pyramid, written by scripts/explode-pmtiles.js at build time
# from the .pmtiles archives. Build output, never source.
web/static/tiles/
web/src/lib/tiles-meta.js

# Gazetteer, generated from the tiles by scripts/build_gazetteer.js
web/static/geo/
