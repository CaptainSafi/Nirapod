# Security headers for Cloudflare Pages and Netlify (both read this file).
# Vercel ignores it and uses vercel.json instead; the two are kept in step.
#
# The Content-Security-Policy is NOT here: SvelteKit emits it as a meta tag with
# a hash for its own inline script. Setting a second one here would fight it.

/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Cross-Origin-Opener-Policy: same-origin
  # The browser itself now refuses a location request from this page, so
  # "we never ask where you are" is enforced rather than promised.
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()

/data/*
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=600

# Map tiles. They are stored gzip-compressed exactly as they came out of
# the PMTiles archive, so the browser has to be told to inflate them:
# MapLibre does not inflate tile bodies itself. If a host ever strips this
# header, rebuild with `explode-pmtiles.js --inflate` and delete this block.
#
# The path is stable across rebuilds, so this cannot be immutable: a new
# basemap would be invisible to anyone holding a cached tile.
/tiles/*
  Content-Encoding: gzip
  Content-Type: application/x-protobuf
  Cache-Control: public, max-age=3600, s-maxage=604800
